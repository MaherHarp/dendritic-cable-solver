    "exp:quick": "node src/experiments.ts --quick",
    "plot": "python3 scripts/plot.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.6.0"
  }
}
