{
  "name": "dendritic-cable-solver",
  "version": "1.0.0",
  "description": "Compartmental neuron simulator built around the O(n) Hines tree solver, verified against cable theory",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
